# Supabase
# Proje ayarları > API sayfasından alınır.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxx
# Service role key SADECE sunucu tarafında (API route'larda) kullanılır,
# asla NEXT_PUBLIC_ ile prefixlenmez, asla client'a gönderilmez.
SUPABASE_SERVICE_ROLE_KEY=xxxxx

# Embedding sağlayıcısı (OpenAI text-embedding-3-small, 1536 boyut)
OPENAI_API_KEY=sk-xxxxx

# Eşleştirme LLM'i (ince eleme aşaması)
ANTHROPIC_API_KEY=sk-ant-xxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# false (veya boş) iken Claude'a hiç gidilmez; pgvector'ün bulduğu ilk 5
# aday, ham offers metinleriyle doğrudan matches'e yazılır (naive mod).
# true yapınca ANTHROPIC_API_KEY zorunlu hale gelir. Bkz. src/lib/naive-matches.ts
# ve src/lib/refine-matches.ts.
ENABLE_AI_REFINEMENT=false

# /admin paneline giriş şifresi. Tanımlı değilse panel tamamen kapalı olur
# (middleware her isteği /admin/login'e yönlendirir, login de "kapalı" der).
ADMIN_PASSWORD=
